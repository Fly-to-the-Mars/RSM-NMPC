          Autocompute Value Bounds:
            Max Value: 3.799999952316284
            Min Value: 0
            Value: false
          Axis: Z
          Channel Name: intensity
          Class: rviz/PointCloud2
          Color: 86; 176; 214
          Color Transformer: RGB8
          Decay Time: 0
          Enabled: true
          Invert Rainbow: false
