<launch>
  <arg name="rviz" default="true" />
  <arg name="backend" default="pcd" doc="pcd: deterministic D1-D4 forest for paper sweeps; native: YOPO sensor_simulator forest." />
  <arg name="density" default="d3" doc="d1, d2, d3, or d4 for the paper dense-forest sweep." />
  <arg name="controller" default="proposed" />
  <arg name="log_csv" default="" />
  <arg name="forest_markers" default="true" />
  <arg name="path_margin" default="0.30" />
  <arg name="lookahead" default="2.10" />
  <arg name="local_range" default="7.8" />
  <arg name="v_max" default="5.4" />

  <!-- Legacy/native YOPO arguments. They are used only with backend:=native. -->
  <arg name="config_file" default="$(find tv_dhocbf_super)/config/tvdhocbf_complex_forest.yaml" />
  <arg name="tree_dist" default="5.2" doc="Native backend only. Smaller values make the YOPO forest denser." />
  <arg name="seed" default="7" />
  <arg name="goal_x" default="0.0" />
  <arg name="goal_y" default="45.0" />
  <arg name="goal_z" default="1.5" />
  <arg name="visual_detail" default="clean" />
  <arg name="show_perception_markers" default="true" />
  <arg name="show_prediction_tube" default="true" />
  <arg name="show_certificate_bars" default="true" />
  <arg name="show_nearest_clearance" default="true" />
  <arg name="reserve_visual_gain" default="4.0" />
  <arg name="reserve_visual_max" default="1.10" />

  <group if="$(eval arg('backend') == 'pcd')">
    <include file="$(find tv_dhocbf_super)/launch/tvdhocbf_yopo_forest.launch">
      <arg name="rviz" value="$(arg rviz)" />
      <arg name="density" value="$(arg density)" />
      <arg name="controller" value="$(arg controller)" />
      <arg name="log_csv" value="$(arg log_csv)" />
      <arg name="forest_markers" value="$(arg forest_markers)" />
      <arg name="path_margin" value="$(arg path_margin)" />
      <arg name="lookahead" value="$(arg lookahead)" />
      <arg name="local_range" value="$(arg local_range)" />
      <arg name="v_max" value="$(arg v_max)" />
    </include>
  </group>

  <group if="$(eval arg('backend') == 'native')">
    <include file="$(find tv_dhocbf_super)/launch/tvdhocbf_yopo_native_forest.launch">
      <arg name="rviz" value="$(arg rviz)" />
      <arg name="controller" value="$(arg controller)" />
      <arg name="log_csv" value="$(arg log_csv)" />
      <arg name="config_file" value="$(arg config_file)" />
      <arg name="tree_dist" value="$(arg tree_dist)" />
      <arg name="seed" value="$(arg seed)" />
      <arg name="goal_x" value="$(arg goal_x)" />
      <arg name="goal_y" value="$(arg goal_y)" />
      <arg name="goal_z" value="$(arg goal_z)" />
      <arg name="visual_detail" value="$(arg visual_detail)" />
      <arg name="show_perception_markers" value="$(arg show_perception_markers)" />
      <arg name="show_prediction_tube" value="$(arg show_prediction_tube)" />
      <arg name="show_certificate_bars" value="$(arg show_certificate_bars)" />
      <arg name="show_nearest_clearance" value="$(arg show_nearest_clearance)" />
      <arg name="reserve_visual_gain" value="$(arg reserve_visual_gain)" />
      <arg name="reserve_visual_max" value="$(arg reserve_visual_max)" />
    </include>
  </group>
</launch>
