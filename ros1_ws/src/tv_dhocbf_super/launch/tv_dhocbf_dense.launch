<launch>
  <arg name="rviz" default="true" />
  <arg name="controller" default="proposed" />

  <include file="$(find tv_dhocbf_super)/launch/tv_dhocbf_click.launch">
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="controller" value="$(arg controller)" />
    <arg name="sim_config" value="dense.yaml" />
    <arg name="goal_x" value="0.0" />
    <arg name="goal_y" value="35.0" />
    <arg name="goal_z" value="1.5" />
    <arg name="control_rate" value="8.0" />
    <arg name="local_range" value="6.0" />
    <arg name="path_margin" value="0.28" />
    <arg name="global_path_extent" value="10.0" />
    <arg name="confidence_inflation" value="0.035" />
    <arg name="horizon_inflation_growth" value="0.002" />
  </include>
</launch>
