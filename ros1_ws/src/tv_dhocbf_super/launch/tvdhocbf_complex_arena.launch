<launch>
  <arg name="rviz" default="true" />
  <arg name="controller" default="proposed" />
  <arg name="log_csv" default="" />
  <arg name="semantic_markers" default="true" />
  <arg name="semantic_labels" default="false" />
  <arg name="visual_detail" default="clean" />
  <arg name="show_perception_markers" default="true" />
  <arg name="show_prediction_tube" default="true" />
  <arg name="show_certificate_bars" default="true" />
  <arg name="show_nearest_clearance" default="true" />
  <arg name="reserve_visual_gain" default="4.0" />
  <arg name="reserve_visual_max" default="1.10" />

  <include file="$(find tv_dhocbf_super)/launch/tvdhocbf_rescue_arena.launch">
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="controller" value="$(arg controller)" />
    <arg name="log_csv" value="$(arg log_csv)" />
    <arg name="semantic_markers" value="$(arg semantic_markers)" />
    <arg name="semantic_labels" value="$(arg semantic_labels)" />
    <arg name="visual_detail" value="$(arg visual_detail)" />
    <arg name="show_perception_markers" value="$(arg show_perception_markers)" />
    <arg name="show_prediction_tube" value="$(arg show_prediction_tube)" />
    <arg name="show_certificate_bars" value="$(arg show_certificate_bars)" />
    <arg name="show_nearest_clearance" value="$(arg show_nearest_clearance)" />
    <arg name="reserve_visual_gain" value="$(arg reserve_visual_gain)" />
    <arg name="reserve_visual_max" value="$(arg reserve_visual_max)" />
  </include>
</launch>
